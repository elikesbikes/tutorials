# Per-host Authelia settings. Do NOT commit the real .env file.
AUTHELIA_DOMAIN=auth-dev.home.elikesbikes.com

# Secrets injected at runtime by start.sh — do not set here
# AUTHELIA_JWT_SECRET           → Proton Pass: HOMELAB / authelia - JWT_SECRET
# AUTHELIA_SESSION_SECRET       → Proton Pass: HOMELAB / authelia - SESSION_SECRET
# AUTHELIA_STORAGE_ENCRYPTION_KEY → Proton Pass: HOMELAB / authelia - STORAGE_ENCRYPTION_KEY
# AUTHELIA_SMTP_PASSWORD        → Proton Pass: HOMELAB / authelia - SMTP_PASSWORD
