# Syncthing API
SYNCTHING_URL=http://192.168.x.x:8384
SYNCTHING_API_KEY=your-api-key-here
SYNCTHING_DEVICE_ID=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
SYNCTHING_FOLDER_ID=your-folder-id

# Monitoring thresholds (seconds)
SYNCTHING_SYNC_BEHIND_THRESHOLD_SECONDS=86400
SYNCTHING_SYNC_PHANTOM_BYTES=1024
SYNCTHING_OFFLINE_THRESHOLD_SECONDS=86400

# Debug logging (0 or 1)
SYNCTHING_HEALTH_DEBUG=0

# ntfy notifications (optional)
NTFY_ENABLED=0
NTFY_URL=https://ntfy.your-server.com
NTFY_TOPIC=syncthing
NTFY_NOTIFY_ON_STARTUP=0
