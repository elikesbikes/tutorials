# Honcho configuration: NO credentials here. LLM_OPENAI_API_KEY is a placeholder that Ollama ignores.
# Models run on Ollama on nvr-prod-2 via hailmary Traefik (https://ai.home.elikesbikes.com, allowlisted).
LOG_LEVEL=INFO
AUTH_USE_AUTH=false
LLM_OPENAI_API_KEY=ollama
VECTOR_STORE_TYPE=pgvector
VECTOR_STORE_MIGRATED=false
EMBEDDING_VECTOR_DIMENSIONS=768
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=nomic-embed-text
EMBEDDING_MODEL_CONFIG__MAX_BATCH_SIZE=10
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://ai.home.elikesbikes.com/v1
DERIVER_ENABLED=true
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=qwen3:4b
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://ai.home.elikesbikes.com/v1
DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
SUMMARY_ENABLED=true
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=qwen3:4b
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=https://ai.home.elikesbikes.com/v1
DREAM_ENABLED=true
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=qwen3:4b
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://ai.home.elikesbikes.com/v1
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=qwen3:4b
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://ai.home.elikesbikes.com/v1
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=qwen3:4b
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=https://ai.home.elikesbikes.com/v1
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=qwen3:4b
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=https://ai.home.elikesbikes.com/v1
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=qwen3:4b
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=https://ai.home.elikesbikes.com/v1
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=qwen3:4b
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=https://ai.home.elikesbikes.com/v1
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=qwen3:4b
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=https://ai.home.elikesbikes.com/v1
# qwen3 'thinks' until its output budget is gone when asked for minimal effort (empty answers, 70 s); 'none' answers in ~2 s (tested 2026-10-02)
DERIVER_MODEL_CONFIG__THINKING_EFFORT=none
SUMMARY_MODEL_CONFIG__THINKING_EFFORT=none
DREAM_DEDUCTION_MODEL_CONFIG__THINKING_EFFORT=none
DREAM_INDUCTION_MODEL_CONFIG__THINKING_EFFORT=none
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__THINKING_EFFORT=none
DIALECTIC_LEVELS__low__MODEL_CONFIG__THINKING_EFFORT=none
DIALECTIC_LEVELS__medium__MODEL_CONFIG__THINKING_EFFORT=none
DIALECTIC_LEVELS__high__MODEL_CONFIG__THINKING_EFFORT=none
DIALECTIC_LEVELS__max__MODEL_CONFIG__THINKING_EFFORT=none
