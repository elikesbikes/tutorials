# Traefik per-host config — NEVER commit the real .env file.

# Cloudflare DNS API token for the ACME DNS-01 challenge.
# Same token works on every host. Needs Zone:DNS:Edit + Zone:Zone:Read on elikesbikes.com.
# Secret injected at runtime by start.sh — do not set here
# CF_DNS_API_TOKEN → Proton Pass: HOMELAB / traefik - CF_DNS_API_TOKEN

# Host-specific dashboard hostname (a matching DNS A record must point to this host).
TRAEFIK_DASHBOARD_HOST=proxy-<hostname>.home.elikesbikes.com

# Container user (host UID/GID). acme.json + secrets must be owned by this user.
PUID=1000
PGID=1000

# Timezone and Graylog syslog target (same across the homelab; override if needed).
TZ=America/Los_Angeles
SYSLOG_ADDRESS=udp://192.168.5.30:514

# NOTE: Dashboard basic-auth lives in secrets/dashboard.htpasswd (git-ignored),
# referenced via basicauth.usersfile — bcrypt hashes can't go through env interpolation.

# Selects which config/dynamic-hosts/<host> dir is mounted (host-specific routers).
PROXY_HOST=tars
