# Loaded by docker-compose.yml via env_file.
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit it.

# Traefik reverse-proxy hostname for THIS host (host-specific). A matching
# Cloudflare DNS record must point to this host. Convention: restic-<host>.home.elikesbikes.com
# Not RESTIC_HOST: restic >= 0.17 treats that as the snapshot host name.
RESTIC_TRAEFIK_HOST=restic-<host>.home.elikesbikes.com

# Restic repository path inside the container
# ./backup/ resolves to the backup symlink (→ NFS mount) in the project directory
RESTIC_REPOSITORY=./backup/
RESTIC_PASSWORD=<your-strong-password>

# Backup schedules now live in per-job config files: jobs/<name>.conf
# (see jobs/example.conf.example). BACKUP_CRON is deprecated — if set with no
# job confs present, the entrypoint generates a legacy job from it and warns.

# ntfy push notification DEFAULTS (leave NTFY_SERVER empty to disable).
# Overridable per job via JOB_NTFY_SERVER / JOB_NTFY_TOPIC in jobs/<name>.conf
NTFY_SERVER=https://ntfy.your-domain.com
NTFY_TOPIC=backups

# HTTP status API port — Uptime Kuma polls this.
# /health returns 503 if ANY job is stale; body lists per-job detail.
STATUS_PORT=8484

# restic backup verbosity DEFAULT: 1 = summary + progress, 2 = log every file
# (2 is very chatty — ~1 line per file). Overridable per job via JOB_VERBOSITY.
RESTIC_VERBOSITY=1

# Backup retention DEFAULTS (used by cleanup.sh, applied per job tag).
# Overridable per job via JOB_KEEP_* in jobs/<name>.conf
# Cleanup is automatically triggered after each successful backup
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
