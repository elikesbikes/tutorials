# Copy to .env and fill in per-host values. Do NOT commit .env.
# On a fresh host, prefer: ./scripts/bootstrap.sh (creates .env + htpasswd, then `up -d`).
# Pipeline deploys assume the host is already bootstrapped (.env + secrets present).

# Cloudflare DNS API token for the ACME DNS-01 challenge (same token on every host).
# Create at https://dash.cloudflare.com/profile/api-tokens with:
#   Zone:DNS:Edit  +  Zone:Zone:Read  on the elikesbikes.com zone.
CF_DNS_API_TOKEN=

# Host-specific dashboard hostname — a DNS A record must point it to this host.
# e.g. proxy-tars / proxy-endurance / proxy-ranger0
TRAEFIK_DASHBOARD_HOST=proxy-<host>.home.elikesbikes.com

# Container user (host UID/GID); acme.json + secrets must be owned by this user.
PUID=1000
PGID=1000

# Timezone and Graylog syslog target.
TZ=America/Los_Angeles
SYSLOG_ADDRESS=udp://192.168.5.30:514

# Dashboard basic-auth is NOT set here — it lives in secrets/dashboard.htpasswd
# (copy secrets/dashboard.htpasswd.example, generate with: htpasswd -nbB admin <password>).
